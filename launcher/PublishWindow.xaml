<Window x:Class="BrokenCharactersLauncher.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broken Characters Mod - Creator"
        Width="760" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFC928" />
        <SolidColorBrush x:Key="TextDim" Color="#9FB3D1" />

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#30FFC928" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#60FFC928" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one big button: gold when there is something to publish, dim otherwise -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#101420" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFC928" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFD95C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#9FB3D1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#FF0E1220" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="28,10,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- title bar (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="-28,0,-28,0" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="CREATOR" Foreground="White" FontSize="18" FontWeight="Black" />
                    <TextBlock Text="  PUBLISH MY MOD" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Black" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" Click="Close_Click" ToolTip="Close" />
            </Grid>

            <!-- ======================================================== step 0: creator key -->
            <StackPanel x:Name="KeyPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Paste your creator key" Foreground="White" FontSize="26" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="You only do this once. The key is a long piece of text the pack owner gave you. It lets this launcher upload your mod, and nothing else." />
                <PasswordBox x:Name="KeyBox" Height="40" Margin="0,22,0,0" FontSize="15" VerticalContentAlignment="Center"
                             Background="#30FFFFFF" Foreground="White" BorderBrush="#60FFFFFF" />
                <TextBlock x:Name="KeyError" Foreground="#FF9A8C" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                <Button x:Name="SaveKeyButton" Content="SAVE KEY" Style="{StaticResource GoldButton}" Margin="0,22,0,0" Click="SaveKey_Click" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"
                           Text="Just here to play? You don't need this window. Close it and press PLAY." />
            </StackPanel>

            <!-- ======================================================== main: pick folder, see changes, publish -->
            <Grid x:Name="MainPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="HelloText" Foreground="{StaticResource TextDim}" FontSize="13" Text="Signed in" />
                    <TextBlock Text="1. Your mod folder" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,12,0,0" />
                    <TextBlock Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="The folder where your Claude keeps the mod (it has &quot;src&quot; or &quot;mods&quot; inside)." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="Refresh" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Refresh_Click" />
                        <Button DockPanel.Dock="Right" x:Name="ChooseFolderButton" Content="Choose folder..." Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ChooseFolder_Click" />
                        <Border Background="#30FFFFFF" CornerRadius="4" Padding="10,7">
                            <TextBlock x:Name="FolderText" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis" Text="No folder chosen yet" />
                        </Border>
                    </DockPanel>
                    <TextBlock Text="2. Your mods" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,18,0,8" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="ModList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#22FFFFFF" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="6,0,0,0" />
                                                    <TextBlock Text="{Binding StatusText}" Foreground="#FFC928" FontSize="13" Margin="14,4,0,0" />
                                                </StackPanel>
                                            </CheckBox>
                                            <StackPanel Visibility="{Binding ConflictVisibility}" Margin="24,8,0,0">
                                                <TextBlock Text="{Binding Conflict}" TextWrapping="Wrap" Foreground="#FF9A8C" FontSize="12" />
                                                <CheckBox IsChecked="{Binding OverwriteOk, Mode=TwoWay}" Margin="0,6,0,0">
                                                    <TextBlock Text="Publish my copy anyway" Foreground="White" FontSize="12" Margin="4,0,0,0" />
                                                </CheckBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="3. What changed? (optional)" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="NoteBox" Height="34" FontSize="14" VerticalContentAlignment="Center" Padding="6,0"
                             Background="#30FFFFFF" Foreground="White" CaretBrush="White" BorderBrush="#60FFFFFF" />
                </StackPanel>

                <Button Grid.Row="3" x:Name="PublishButton" Content="NOTHING TO PUBLISH" Style="{StaticResource GoldButton}" Margin="0,16,0,0" IsEnabled="False" Click="Publish_Click" />

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#30FFFFFF" BorderThickness="0" />
                    <TextBlock x:Name="StatusLine" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" Text="" />
                    <TextBlock x:Name="ResultText" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" x:Name="ChangeKeyButton" Content="Change key" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11" Click="ChangeKey_Click" />
                        <Button x:Name="CopyErrorsButton" Content="Copy errors for Claude" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Visibility="Collapsed" Click="CopyErrors_Click" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
