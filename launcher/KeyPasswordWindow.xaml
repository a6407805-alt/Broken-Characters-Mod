<Window x:Class="BrokenCharactersLauncher.KeyPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broken Characters Mod - Key passwords"
        Width="560" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFC928" />
        <SolidColorBrush x:Key="TextDim" Color="#C9D6EA" />

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#101420" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFC928" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFD95C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#FF0E1220" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="28,10,28,24">
        <StackPanel>
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="-28,0,-28,0" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="KEY" Foreground="White" FontSize="18" FontWeight="Black" />
                    <TextBlock Text="  PASSWORDS" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Black" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" Click="Close_Click" ToolTip="Close" />
            </Grid>

            <TextBlock Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Lock a key with a password. After that, people type the password instead of pasting the long key. Anyone could download the locked copy, so pick a password that's hard to guess (a few random words works well)." />

            <TextBlock Style="{StaticResource Label}" Text="Which key" />
            <ComboBox x:Name="WhichBox" Height="32" FontSize="14" SelectionChanged="WhichBox_SelectionChanged">
                <ComboBoxItem x:Name="MineItem" Content="My creator key (the one this launcher is signed in with)" IsSelected="True" />
                <ComboBoxItem x:Name="FriendItem" Content="A friend's creator key (owner only)" />
                <ComboBoxItem x:Name="ExtrasItem" Content="The extras key (owner only)" />
            </ComboBox>

            <StackPanel x:Name="KeyRow" Visibility="Collapsed">
                <TextBlock x:Name="KeyLabel" Style="{StaticResource Label}" Text="Paste the key" />
                <PasswordBox x:Name="KeyBox" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="Password (8+ characters)" />
            <PasswordBox x:Name="PasswordBox1" />
            <TextBlock Style="{StaticResource Label}" Text="Type it again" />
            <PasswordBox x:Name="PasswordBox2" />

            <TextBlock x:Name="StatusText" Foreground="#FF9A8C" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button x:Name="LockButton" Content="LOCK WITH PASSWORD" Style="{StaticResource GoldButton}" Margin="0,14,0,0" Click="Lock_Click" />
        </StackPanel>
    </Border>
</Window>
