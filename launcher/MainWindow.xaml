<Window x:Class="BrokenCharactersLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broken Characters Mod"
        Width="1280" Height="780"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ============================================================ palette -->
        <SolidColorBrush x:Key="Accent" Color="#FFC928" />
        <SolidColorBrush x:Key="Panel" Color="#C0101420" />
        <SolidColorBrush x:Key="PanelBorder" Color="#55FFFFFF" />
        <SolidColorBrush x:Key="TextDim" Color="#9FB3D1" />

        <!-- ============================================================ title bar buttons -->
        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ outlined gold buttons (Retry, Save) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#30FFC928" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#60FFC928" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ PLAY (gold + glow when ready, grey while updating) -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1205" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" BorderThickness="2" BorderBrush="#FFE89A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFD95A" Offset="0" />
                                    <GradientStop Color="#E0A410" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFC928" BlurRadius="30" ShadowDepth="0" Opacity="0.9" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#55606A7A" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF" />
                                <Setter TargetName="Bg" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#88FFFFFF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ gold progress bar -->
        <Style x:Key="GoldProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="#40FFFFFF" CornerRadius="5" />
                            <Border x:Name="PART_Track" CornerRadius="5" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5" Background="{TemplateBinding Foreground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFC928" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ roster arrows (< and >) -->
        <Style x:Key="RosterArrow" TargetType="Button">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="96" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#A0101420" BorderBrush="#80FFC928" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E0FFC928" />
                                <Setter Property="Foreground" Value="#1A1205" />
                            </Trigger>
                            <!-- Disabled = already at that end of the list: fade the arrow out -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================ character card (Mario Strikers style)
             The whole card is skewed into a parallelogram; the portrait and name inside are skewed back the
             other way so they stay upright while being clipped by the slanted frame. -->
        <DataTemplate x:Key="CharacterCard">
            <Grid x:Name="Card" Width="176" Height="292" Margin="-4,0,-4,0" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
                  ToolTip="{Binding Tagline}">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform AngleX="-12" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Frame: accent-coloured edge, dark fill, clips everything to the slanted shape -->
                <Border x:Name="Frame" BorderBrush="{Binding AccentBrush}" BorderThickness="3" CornerRadius="4" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2A3350" Offset="0" />
                            <GradientStop Color="#0B0E18" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>

                    <Grid>
                        <!-- Portrait (counter-skewed so it stays upright; oversized so the slant never shows a gap) -->
                        <Image Source="{Binding Portrait}" Stretch="UniformToFill" Margin="-40,0,-40,0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <SkewTransform AngleX="12" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Accent slash across the top corner -->
                        <Rectangle Fill="{Binding AccentBrush}" Height="6" VerticalAlignment="Top" Opacity="0.9" />

                        <!-- Name plate: dark gradient + name + tagline -->
                        <Border VerticalAlignment="Bottom" Padding="12,26,10,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#E0000000" Offset="0.45" />
                                    <GradientStop Color="#F0000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <StackPanel.RenderTransform>
                                    <SkewTransform AngleX="12" />
                                </StackPanel.RenderTransform>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="Black" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- NEW badge for the most recent additions -->
                        <Border Visibility="{Binding NewBadgeVisibility}" Background="{StaticResource Accent}" CornerRadius="3"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Padding="7,1">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="12" />
                            </Border.RenderTransform>
                            <TextBlock Text="NEW" Foreground="#1A1205" FontSize="11" FontWeight="Black" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Hover: pop the card forward and brighten its glow -->
            <DataTemplate.Triggers>
                <EventTrigger SourceName="Card" RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.07" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.07" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="26" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger SourceName="Card" RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.5" Duration="0:0:0.15" />
                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="10" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================================================ map / game mode thumbnail card -->
        <DataTemplate x:Key="TileCard">
            <Border x:Name="Tile" Width="214" Height="120" Margin="0,0,12,0" CornerRadius="6" ClipToBounds="True"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="{Binding Subtitle}">
                <Grid>
                    <!-- Background image (placeholder art until the real screenshots exist) -->
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                    <!-- Dark gradient behind the text so it's readable on any image -->
                    <Border VerticalAlignment="Bottom" Height="62">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#E6000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#C8D2E4" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Optional corner badge, e.g. COMING SOON -->
                    <Border Visibility="{Binding BadgeVisibility}" Background="#E0101420" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="6,1">
                        <TextBlock Text="{Binding Badge}" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Horizontal list panel shared by the roster and the two tile rows -->
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- ================================================================ borderless, rounded frame + space art -->
    <Border CornerRadius="14" BorderBrush="#60FFC928" BorderThickness="1">
        <Border.Background>
            <ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill" />
        </Border.Background>

        <Grid>
            <!-- Darkening gradient so the UI reads over any art -->
            <Border CornerRadius="14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0000000" Offset="0" />
                        <GradientStop Color="#40000000" Offset="0.45" />
                        <GradientStop Color="#D8000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="24,0,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />    <!-- title bar -->
                    <RowDefinition Height="*" />     <!-- 1. character roster (top half) -->
                    <RowDefinition Height="Auto" />  <!-- 2. maps + game modes -->
                    <RowDefinition Height="Auto" />  <!-- 3. extras / status / PLAY -->
                </Grid.RowDefinitions>

                <!-- ======================================================== title bar (drag to move) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="-24,0,-24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="BROKEN CHARACTERS" Foreground="White" FontSize="18" FontWeight="Black" />
                        <TextBlock Text="  MOD" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Black" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0">
                        <!-- Patch notes live in a pop-up now; the changelog code still fills ChangelogText -->
                        <!-- Opt-in: make Steam's Play button open this launcher (it closes and reopens Steam to save it) -->
                        <ToggleButton x:Name="SteamPlayToggle" Click="SteamPlayToggle_Click" Height="34" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                                      FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent"
                                      ToolTip="When on, pressing Play in Steam opens this launcher first (updates, then the game).">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Foreground" Value="#9FB3D1" />
                                    <Setter Property="Content" Value="STEAM PLAY &#x2192; LAUNCHER: OFF" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="#30FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#40FFC928" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="#FFC928" />
                                            <Setter Property="Content" Value="STEAM PLAY &#x2192; LAUNCHER: ON" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <!-- Reload the cards and patch notes, check for a newer pack and a newer launcher -->
                        <Button x:Name="RefreshButton" Content="&#x21BB; CHECK FOR UPDATES" Click="Refresh_Click" Height="34" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}"
                                ToolTip="Reload everything and check for updates (pack and launcher).">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#30FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#50FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Dev only: shown when the BCM Dev Tools mod is installed on this PC (never shipped to friends).
                             Starts the game straight into the test arena; skips the pack update on purpose. -->
                        <Button x:Name="TestLevelButton" Content="&#x25B6; TEST LEVEL" Click="TestLevel_Click" Height="34" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#7CFC9A" Visibility="Collapsed"
                                ToolTip="Dev: launch straight into the test arena (skips intro, menus and the pack update).">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#3022C55E" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#5022C55E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- The group's Suno songs for the Jukebox mod -->
                        <Button x:Name="JukeboxButton" Content="&#x266B; JUKEBOX" Click="Jukebox_Click" Height="34" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#FFC928"
                                ToolTip="Add our Suno songs to the in-game jukebox.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#30FFC928" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#55FFC928" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- For mod creators: upload your own mod to the pack (asks for a creator key the first time) -->
                        <Button x:Name="CreatorButton" Content="CREATOR" Click="Creator_Click" Height="34" Padding="12,0" Margin="0,0,6,0" Cursor="Hand"
                                FontSize="12" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="#9FB3D1"
                                ToolTip="For mod creators: publish your own mod to the pack.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#30FFFFFF" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#50FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <ToggleButton x:Name="PatchNotesToggle" Content="PATCH NOTES" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold"
                                      Background="Transparent" BorderThickness="0" Padding="12,0" Height="34" Cursor="Hand" Margin="0,0,6,0" />
                        <Button Content="&#x2014;" Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Minimize" />
                        <Button Content="&#x2715;" Style="{StaticResource TitleButton}" Click="Close_Click" ToolTip="Close" />
                    </StackPanel>
                    <Popup IsOpen="{Binding IsChecked, ElementName=PatchNotesToggle}" PlacementTarget="{Binding ElementName=PatchNotesToggle}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="#F0101420" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="8" Padding="18,14" Width="460" MaxHeight="420">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="LATEST CHANGES" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,8,0,0" Text="Installed: -" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ChangelogText" Foreground="#E6EAF2" FontSize="13" TextWrapping="Wrap" LineHeight="20" Text="Loading release notes..." />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- ======================================================== 1. CHARACTER ROSTER -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                        <TextBlock Text="CHARACTERS" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Black" />
                        <TextBlock x:Name="RosterCountText" Foreground="{StaticResource TextDim}" FontSize="13" Margin="10,1,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <!-- The roster itself: scroll with the wheel, by dragging, or with the arrows -->
                        <ScrollViewer x:Name="RosterScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" Padding="0"
                                      PreviewMouseWheel="Roster_PreviewMouseWheel" ScrollChanged="Roster_ScrollChanged"
                                      PreviewMouseLeftButtonDown="Roster_DragStart" PreviewMouseMove="Roster_DragMove" PreviewMouseLeftButtonUp="Roster_DragEnd">
                            <!-- The margin lives on the list (not the ScrollViewer's Padding) so the slanted corners of the first and
                                 last cards stay inside the scroll area instead of being clipped -->
                            <ItemsControl x:Name="RosterList" ItemTemplate="{StaticResource CharacterCard}" ItemsPanel="{StaticResource HorizontalPanel}"
                                          VerticalAlignment="Center" Margin="64,14,64,14" />
                        </ScrollViewer>

                        <!-- < and > overlaying the edges -->
                        <Button x:Name="RosterLeft" Content="&#x276E;" Style="{StaticResource RosterArrow}" HorizontalAlignment="Left" Click="RosterLeft_Click" ToolTip="Scroll left" />
                        <Button x:Name="RosterRight" Content="&#x276F;" Style="{StaticResource RosterArrow}" HorizontalAlignment="Right" Click="RosterRight_Click" ToolTip="Scroll right" />
                    </Grid>
                </Grid>

                <!-- ======================================================== 2. NEW MAPS | GAME MODES -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="NEW MAPS" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Black" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TileRow_PreviewMouseWheel">
                                <ItemsControl x:Name="MapsList" ItemTemplate="{StaticResource TileCard}" ItemsPanel="{StaticResource HorizontalPanel}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10,14,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="GAME MODES" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Black" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TileRow_PreviewMouseWheel">
                                <ItemsControl x:Name="ModesList" ItemTemplate="{StaticResource TileCard}" ItemsPanel="{StaticResource HorizontalPanel}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ======================================================== 3. EXTRAS | STATUS | PLAY (logic unchanged) -->
                <Grid Grid.Row="3" Margin="0,14,0,0" Height="96">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: friends-only extras key -->
                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <Grid>
                            <StackPanel x:Name="ExtrasPanel" VerticalAlignment="Center">
                                <TextBlock Text="EXTRAS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Black" />
                                <TextBlock Text="Got an extras key? Paste it here once (Ctrl+V)." Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,6" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="SaveKeyButton" Content="Save" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SaveKey_Click" />
                                    <PasswordBox x:Name="ExtrasKeyBox" Height="30" VerticalContentAlignment="Center" Background="#30FFFFFF" Foreground="White" BorderBrush="#60FFFFFF" />
                                </DockPanel>
                            </StackPanel>
                            <!-- Shown instead once a key is saved -->
                            <StackPanel x:Name="ExtrasActivePanel" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="EXTRAS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Black" />
                                <TextBlock Text="&#x2714;  Friends-only extras are active" Foreground="#7CFF7C" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Center: status + progress -->
                    <Border Grid.Column="1" Margin="16,0,16,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="18,12">
                        <StackPanel VerticalAlignment="Center">
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" x:Name="RetryButton" Content="Retry" Style="{StaticResource GhostButton}" Visibility="Collapsed" Click="Retry_Click" />
                                <TextBlock DockPanel.Dock="Right" x:Name="ProgressText" Foreground="{StaticResource TextDim}" FontSize="13" Margin="10,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Starting..." Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ProgressBar x:Name="DownloadProgress" Style="{StaticResource GoldProgress}" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>

                    <!-- Right: PLAY -->
                    <Button Grid.Column="2" x:Name="PlayButton" Content="PLAY" Style="{StaticResource PlayButton}" IsEnabled="False" Click="PlayButton_Click" />
                </Grid>
            </Grid>

            <!-- Right-edge tab: opens the install & update guide (PDF) in the browser -->
            <Button x:Name="GuideTabButton" Click="GuideTab_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="26" Height="68" Margin="0,0,-13,0" Cursor="Hand" Panel.ZIndex="50"
                    ToolTip="Open the install &amp; update guide (PDF)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="13" Background="#D8101420" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <TextBlock x:Name="Arrow" Text="&#10095;" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Arrow" Property="Foreground" Value="#1A1205" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
