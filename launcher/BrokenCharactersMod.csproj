<Project Sdk="Microsoft.NET.Sdk">

  <!-- Broken Characters Launcher: a Warframe-style updater + PLAY button for the mod pack.
       Built on the Windows runner by .github/workflows/build.yml and published as Broken-Characters-Mod.exe.
       Self-contained single file, so friends don't need to install .NET first. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Broken-Characters-Mod</AssemblyName>
    <RootNamespace>BrokenCharactersLauncher</RootNamespace>
    <ApplicationIcon>Assets\launcher.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Broken Characters Mod</Product>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\background.jpg" />
    <Resource Include="Assets\Roster\*.png" />
    <Resource Include="Assets\Tiles\*.png" />
    <Resource Include="roster.json" />
  </ItemGroup>

</Project>
