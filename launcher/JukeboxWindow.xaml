<Window x:Class="BrokenCharactersLauncher.JukeboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Broken Characters Mod - Jukebox"
        Width="760" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFC928" />
        <SolidColorBrush x:Key="TextDim" Color="#9FB3D1" />

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#30FFC928" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#60FFC928" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one big button: gold when there is something to publish, dim otherwise -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#101420" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Black" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#FFC928" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFD95C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="#9FB3D1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#FF0E1220" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="28,10,28,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title bar (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="-28,0,-28,0" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <TextBlock Text="&#x266B; JUKEBOX" Foreground="White" FontSize="18" FontWeight="Black" />
                    <TextBlock Text="  OUR SONGS" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="Black" />
                </StackPanel>
                <Button Content="&#x2715;" Style="{StaticResource TitleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" Click="Close_Click" ToolTip="Close" />
            </Grid>

            <!-- add a song -->
            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                <TextBlock Text="Add a song" Foreground="White" FontSize="18" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"
                           Text="On Suno, press Share on the song and copy the link, then paste it here. The song must be public." />
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="AddButton" Content="ADD" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Add_Click" />
                    <TextBox x:Name="LinkBox" Height="34" FontSize="14" VerticalContentAlignment="Center" Padding="6,0"
                             Background="#30FFFFFF" Foreground="White" CaretBrush="White" BorderBrush="#60FFFFFF" KeyDown="LinkBox_KeyDown" />
                </DockPanel>
                <CheckBox x:Name="ShareBox" Margin="0,10,0,0" IsChecked="True">
                    <TextBlock x:Name="ShareText" Text="Add it for the whole group (everyone's launcher downloads it)" Foreground="White" FontSize="13" Margin="4,0,0,0" />
                </CheckBox>
                <TextBlock Text="Songs" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,18,0,2" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="You can also drop MP3 files into the folder (Open folder), then press Refresh." />
            </StackPanel>

            <!-- the list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="SongList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Left" Content="{Binding PlayText}" Style="{StaticResource GhostButton}" Padding="10,4" Width="40"
                                                Click="Preview_Click" ToolTip="Listen here" IsEnabled="{Binding CanPlay}" />
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                                Click="Remove_Click" Visibility="{Binding RemoveVisibility}" />
                                        <StackPanel Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextDim}" FontSize="12" />
                                                <TextBlock Text="{Binding Where}" Foreground="#FFC928" FontSize="12" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextDim}" FontSize="12" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextDim}" FontSize="14" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="No songs yet. Paste a Suno link above." />
                </StackPanel>
            </ScrollViewer>

            <!-- status + how it works in game -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock x:Name="StatusLine" Foreground="White" FontSize="14" TextWrapping="Wrap" Text="" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="In game: a song vote opens each stage and when a song ends. Press 7 / 8 / 9 to vote, J for a vote now, Shift + / - for volume. The host can stop the music with K." />
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" x:Name="SyncButton" Content="&#x21BB; Refresh" ToolTip="Show songs you added to the folder and download new group songs" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Sync_Click" />
                    <Button DockPanel.Dock="Right" Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" />
                    <TextBlock />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
