<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>NU1701;CS0618</NoWarn>
    <AssemblyName>CharacterStatus</AssemblyName>
    <RootNamespace>CharacterStatus</RootNamespace>
  </PropertyGroup>

  <!-- Same NuGet setup as the other mods. status.json ships next to the dll from mods/CharacterStatus/. -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="RiskOfRain2.GameLibs" Version="1.4.1-r.0" />
    <PackageReference Include="R2API.ContentManagement" Version="1.0.11" />
    <PackageReference Include="R2API.Language" Version="1.*" />
  </ItemGroup>

</Project>
